# ── Agent Image ──────────────────────────────────────────────
# Pin to a specific release tag. Never use :latest in production.
HERMES_VERSION=v0.6.0

# ── LLM Provider (pick one) ─────────────────────────────────
# Option A: Cloud API
ANTHROPIC_API_KEY=sk-ant-CHANGEME
# OPENROUTER_API_KEY=
# NOUS_PORTAL_CLIENT_ID=

# Option B: Local model on another machine (Ollama, exo, vLLM, etc.)
# Uncomment and set these, comment out the cloud key above.
# LOCAL_MODEL_API_BASE=http://192.168.1.100:11434/v1
# LOCAL_MODEL_NAME=qwen3:72b
# LOCAL_MODEL_API_KEY=unused

# ── Telegram Gateway ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGEME
TELEGRAM_ALLOWED_USERS=CHANGEME
TELEGRAM_HOME_CHANNEL=CHANGEME

# ── Gateway Auth ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
GATEWAY_AUTH_TOKEN=CHANGEME

# ── Dashboard Auth (Basic Auth) ─────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGEME
# Generate with: openssl rand -hex 32
DASHBOARD_SECRET=CHANGEME

# ── Dashboard Access ─────────────────────────────────────────
# Tailscale-only: bind to Tailscale interface so phone/iPad can reach it.
# Set to your server's Tailscale IP (run: tailscale ip -4)
DASHBOARD_BIND=100.x.x.x

# ── External APIs ───────────────────────────────────────────
OPENWEATHERMAP_API_KEY=CHANGEME
TODOIST_API_KEY=CHANGEME

# ── Timezone ────────────────────────────────────────────────
TZ=America/Chicago

# ── Container UID/GID (match host data/ ownership) ─────────
HERMES_UID=1000
HERMES_GID=1000
