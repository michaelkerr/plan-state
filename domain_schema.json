{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan-State Domain Definition",
  "description": "Complete definition of a planning domain with all activities, steps, conditions, and triggers. Used by LLMs to author domain plans that can be bulk-loaded into the plan-state database.",
  "type": "object",
  "required": ["name", "activities"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable domain name (e.g. 'Cool-Season Lawn Care', 'Zone 7a Fall Garden')"
    },
    "location": {
      "type": "string",
      "description": "Location for weather queries, in a format OpenWeatherMap accepts (e.g. 'Richmond,VA,US')"
    },
    "notes": {
      "type": "string",
      "description": "Freeform notes about the domain (zone, soil type, constraints, etc.)"
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/activity" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "activity": {
      "type": "object",
      "required": ["name", "trigger_type", "trigger_def"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Activity name (e.g. 'Apply Pre-Emergent Herbicide')"
        },
        "description": {
          "type": "string",
          "description": "What this activity is and why it matters"
        },
        "group_name": {
          "type": "string",
          "description": "Optional free-form bundle label within the domain (crop, bed, species, project). Display and organization only -- carries no trigger logic."
        },
        "trigger_type": {
          "type": "string",
          "enum": ["calendar", "condition", "dependency", "compound"]
        },
        "trigger_def": { "$ref": "#/$defs/trigger_def" },
        "recurrence": { "$ref": "#/$defs/recurrence" },
        "sort_order": {
          "type": "integer",
          "default": 0,
          "description": "Display ordering within the domain"
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      },
      "additionalProperties": false
    },
    "trigger_def": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["calendar", "condition", "dependency", "compound"]
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "ISO date for calendar triggers"
        },
        "after": {
          "type": "string",
          "format": "date",
          "description": "Earliest date for compound calendar conditions"
        },
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_clause" },
          "description": "All conditions must be met (for condition triggers)"
        },
        "activity_id": {
          "type": "string",
          "description": "Referenced activity ID for dependency triggers"
        },
        "activity_ref": {
          "type": "string",
          "description": "Activity name reference for dependency triggers (resolved to ID during load)"
        },
        "event": {
          "type": "string",
          "enum": ["completed"],
          "description": "Dependency event type"
        },
        "offset_days": {
          "type": "integer",
          "default": 0,
          "description": "Days after dependency event to fire"
        },
        "operator": {
          "type": "string",
          "enum": ["AND", "OR"],
          "description": "Compound trigger operator"
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/trigger_def" },
          "description": "Sub-triggers for compound triggers"
        }
      },
      "additionalProperties": false
    },
    "condition_clause": {
      "type": "object",
      "required": ["metric", "operator", "value"],
      "properties": {
        "metric": {
          "type": "string",
          "enum": ["daily_high", "daily_low", "temp_high", "temp_low", "soil_temp"],
          "description": "Weather metric to evaluate"
        },
        "operator": {
          "type": "string",
          "enum": [">=", "<=", ">", "<", "=="]
        },
        "value": {
          "type": "number",
          "description": "Threshold value"
        },
        "sustained_days": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of consecutive days the condition must hold"
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["name", "step_type", "lead_days"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Step name (e.g. 'Order herbicide', 'Water in application')"
        },
        "description": {
          "type": "string"
        },
        "step_type": {
          "type": "string",
          "enum": ["prep", "follow_up"]
        },
        "lead_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Days before (prep) or after (follow_up) the trigger date"
        },
        "condition": {
          "type": "object",
          "description": "Optional conditional activation logic for this step"
        }
      },
      "additionalProperties": false
    },
    "recurrence": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["annual", "monthly", "weekly", "custom"],
          "description": "Recurrence pattern"
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "description": "Repeat every N units"
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Month for annual recurrence"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "description": "Day of month"
        }
      },
      "additionalProperties": false
    }
  }
}
