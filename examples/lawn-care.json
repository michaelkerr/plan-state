{
  "name": "Cool-Season Lawn Care",
  "location": "Richmond,VA,US",
  "notes": "Zone 7a, ~8000 sqft tall fescue. Irrigated. Full sun front, partial shade back.",
  "activities": [
    {
      "name": "Apply Pre-Emergent Herbicide",
      "description": "Granular pre-emergent (Barricade/prodiamine) to prevent crabgrass. Must go down before soil temps sustain 55F. Creates chemical barrier in top inch of soil that breaks down over 3-4 months.",
      "trigger_type": "compound",
      "trigger_def": {
        "type": "compound",
        "operator": "AND",
        "conditions": [
          {
            "type": "calendar",
            "after": "2027-02-15"
          },
          {
            "type": "condition",
            "all": [
              {
                "metric": "daily_high",
                "operator": ">=",
                "value": 55,
                "sustained_days": 3
              }
            ]
          }
        ]
      },
      "sort_order": 1,
      "steps": [
        {
          "name": "Check Barricade inventory",
          "step_type": "prep",
          "lead_days": 14,
          "description": "Need 4 lbs for 8000 sqft at standard rate"
        },
        {
          "name": "Order Barricade if needed",
          "step_type": "prep",
          "lead_days": 10
        },
        {
          "name": "Calibrate spreader",
          "step_type": "prep",
          "lead_days": 1
        },
        {
          "name": "Water in application",
          "step_type": "follow_up",
          "lead_days": 1,
          "description": "0.5 inches of water to activate"
        }
      ]
    },
    {
      "name": "Spring Fertilizer Application",
      "description": "Light nitrogen application (0.5 lb N / 1000 sqft) once grass is actively growing. Too early risks feeding weeds; too late misses spring growth window.",
      "trigger_type": "dependency",
      "trigger_def": {
        "type": "dependency",
        "activity_ref": "Apply Pre-Emergent Herbicide",
        "event": "completed",
        "offset_days": 21
      },
      "sort_order": 2,
      "steps": [
        {
          "name": "Check fertilizer inventory",
          "step_type": "prep",
          "lead_days": 7
        },
        {
          "name": "Mow before applying",
          "step_type": "prep",
          "lead_days": 1,
          "description": "Mow a day before so granules reach soil"
        },
        {
          "name": "Water in fertilizer",
          "step_type": "follow_up",
          "lead_days": 1
        }
      ]
    },
    {
      "name": "Sharpen Mower Blades",
      "description": "Sharpen or replace mower blades before mowing season starts. Dull blades tear grass, increasing disease susceptibility.",
      "trigger_type": "calendar",
      "trigger_def": {
        "type": "calendar",
        "date": "2027-03-01"
      },
      "sort_order": 3,
      "steps": [
        {
          "name": "Remove blades",
          "step_type": "prep",
          "lead_days": 3
        },
        {
          "name": "Sharpen or buy replacements",
          "step_type": "prep",
          "lead_days": 2
        },
        {
          "name": "Reinstall and test",
          "step_type": "follow_up",
          "lead_days": 0
        }
      ]
    },
    {
      "name": "Fall Aeration and Overseeding",
      "description": "Core aerate then overseed with tall fescue. Best window is when daily highs drop below 85F consistently in early fall.",
      "trigger_type": "compound",
      "trigger_def": {
        "type": "compound",
        "operator": "AND",
        "conditions": [
          {
            "type": "calendar",
            "after": "2027-08-25"
          },
          {
            "type": "condition",
            "all": [
              {
                "metric": "daily_high",
                "operator": "<=",
                "value": 85,
                "sustained_days": 3
              }
            ]
          }
        ]
      },
      "sort_order": 4,
      "steps": [
        {
          "name": "Reserve aerator rental",
          "step_type": "prep",
          "lead_days": 14
        },
        {
          "name": "Buy tall fescue seed",
          "step_type": "prep",
          "lead_days": 7,
          "description": "Need ~40 lbs for 8000 sqft overseeding rate"
        },
        {
          "name": "Buy starter fertilizer",
          "step_type": "prep",
          "lead_days": 7
        },
        {
          "name": "Mow short (2 inches)",
          "step_type": "prep",
          "lead_days": 1
        },
        {
          "name": "Water daily for 2 weeks",
          "step_type": "follow_up",
          "lead_days": 1,
          "description": "Keep seed moist until germination"
        },
        {
          "name": "First mow at 3.5 inches",
          "step_type": "follow_up",
          "lead_days": 21
        }
      ]
    }
  ]
}
