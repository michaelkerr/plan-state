# dispatch configuration. Copy to .env and fill in. Never commit .env.
#
# Used by `docker compose` (root docker-compose.yml) automatically.
# For a local install, export these in your shell or put them in the
# "env" block of your MCP client config instead.

# Free key: https://home.openweathermap.org/users/sign_up
# (new keys can take up to an hour to activate)
OWM_API_KEY=

# Where your weather comes from: City,ST,Country
DISPATCH_LOCATION=Nashville,TN,US

# Minutes between weather/trigger evals when no external scheduler runs them.
# 60 is plenty; 0 turns the built-in scheduler off (e.g. under Hermes cron).
DISPATCH_EVAL_MINUTES=60

# Local time zone, so "today" in briefings matches yours
TZ=America/Chicago

# Optional
# DISPATCH_PORT=8082                 # host port for the HTTP/MCP server
# DISPATCH_DB=~/.plansync/dispatch.db  # local installs only; Docker uses /data
# DISPATCH_CLIENT=claude             # name recorded on every change (source attribution)
