gideon-data/config.yaml.bak*

# Hermes bundled skills — track only our plansync skills via negation
gideon-data/skills/*
!gideon-data/skills/plansync.md
!gideon-data/skills/plansync-briefing.md

# SQLite runtime files
*.db
*.db-wal
*.db-shm

# Hermes lock files
gideon-data/gateway.lock
gideon-data/*.lock
gideon-data/kanban/.dispatcher.lock

# Sync output (runtime data)
plansync-data/sync-output/*.json

# Python
__pycache__/
*.pyc
