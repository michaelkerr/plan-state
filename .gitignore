# Secrets
.env
gideon-data/.env

# macOS resource forks
._*
.DS_Store

# Hermes runtime data
gideon-data/sessions/
gideon-data/memory/
gideon-data/logs/
gideon-data/cache/
gideon-data/cron/
gideon-data/bin/
gideon-data/.local/
gideon-data/auth.json
gideon-data/auth.lock
gideon-data/gateway.pid
gideon-data/gateway_state.json
gideon-data/kanban.db
gideon-data/channel_directory.json
gideon-data/context_length_cache.yaml
gideon-data/SOUL.md
